# OnePlus V Pro 内置默认线程规则 (AppOpt 兼容; 文件名沿用 applist.prop)
# 游戏段采用 Metric 引擎自适应模板: 各引擎渲染主线程绑大档, 任务/工作线程绑中核。
# 基线核号 0-2 小 / 3-5 中 / 6-7 大档; App 导入时按本机 CPU 簇布局自动重映射。

#系统进程

surfaceflinger{RenderEngine}=6-7
surfaceflinger{app*}=3-6
surfaceflinger{sf*}=3-6
surfaceflinger{*EventThread}=3-6
surfaceflinger{surfaceflinger}=3-5
surfaceflinger{[Bb]inder:*}=0-2
system_server{RenderThread}=6-7
system_server{*Input*}=3-6
system_server{InputReader}=3-5
system_server{HeapTaskDaemon}=0-2
system_server{[Bb]inder:*}=0-2
vendor.qti.hardware.display.composer-service{composer-servic}=3-5

com.miui.home{com.miui.home}=3-5
com.miui.home{*[!e!r]Thread}=3-5
com.miui.home{Thread-*}=3-5
com.miui.home{Thread*}=3-5
